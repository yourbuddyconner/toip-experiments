{
  "name": "@toip-tools/eventlog",
  "version": "0.1.1",
  "description": "KERI key event logs and witnessed audit trails in TypeScript: rotate keys with pre-rotation and make tampering, forks and stolen keys detectable.",
  "keywords": [
    "toip",
    "trust-over-ip",
    "decentralized-identity",
    "ssi",
    "typescript",
    "keri",
    "key-event-receipt-infrastructure",
    "kel",
    "cesr",
    "witness",
    "audit-trail",
    "tamper-evident",
    "transparency-log",
    "did-keri",
    "audit-log"
  ],
  "homepage": "https://toip.tools/toolkit/eventlog/",
  "bugs": {
    "url": "https://github.com/yourbuddyconner/toip-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourbuddyconner/toip-tools.git",
    "directory": "packages/eventlog"
  },
  "license": "Apache-2.0",
  "author": "Conner Swann",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@toip-tools/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "@toip-tools/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@toip-tools/trust-core": "0.1.1",
    "cborg": "6.2.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
