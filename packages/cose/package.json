{
  "name": "@toip-tools/cose",
  "version": "0.1.0",
  "description": "Deterministic CBOR and COSE_Sign1, with Ed25519, P-256, WebCrypto and passkey signers.",
  "keywords": [
    "toip",
    "cose",
    "cose-sign1",
    "cbor",
    "webauthn",
    "passkey",
    "ed25519",
    "p-256"
  ],
  "homepage": "https://toip.tools/toolkit/cose/",
  "bugs": {
    "url": "https://github.com/yourbuddyconner/toip-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourbuddyconner/toip-tools.git",
    "directory": "packages/cose"
  },
  "license": "Apache-2.0",
  "author": "Conner Swann",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@toip-tools/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "cborg": "6.2.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
