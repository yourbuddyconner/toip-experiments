{
  "name": "@toip-tools/mandates",
  "version": "0.1.0",
  "description": "Delegation credentials for people and AI agents: bounded, revocable authority with spending limits, chains that can only narrow, policy checks and human approvals.",
  "keywords": [
    "toip",
    "trust-over-ip",
    "decentralized-identity",
    "ssi",
    "typescript",
    "ai-agents",
    "agent-authorization",
    "delegation",
    "delegated-authority",
    "spending-limits",
    "authorization",
    "verifiable-credentials",
    "rego",
    "opa",
    "mandates"
  ],
  "homepage": "https://toip.tools/toolkit/mandates/",
  "bugs": {
    "url": "https://github.com/yourbuddyconner/toip-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourbuddyconner/toip-tools.git",
    "directory": "packages/mandates"
  },
  "license": "Apache-2.0",
  "author": "Conner Swann",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@toip-tools/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./policy.wasm": "./policy/policy.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "policy/policy.wasm",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "policy": "opa build -t wasm -e mandates/check/decision -e mandates/check/narrowing -o policy/bundle.tar.gz policy/check.rego && tar -xzf policy/bundle.tar.gz -C policy /policy.wasm && rm policy/bundle.tar.gz && node scripts/policy-hash.mjs",
    "policy:test": "opa test policy/"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@toip-tools/trust-core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
