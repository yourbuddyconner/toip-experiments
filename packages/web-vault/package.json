{
  "name": "@toip-tools/web-vault",
  "version": "0.1.1",
  "description": "Browser storage for identity seeds and account data, encrypted with a passkey or passphrase.",
  "keywords": [
    "toip",
    "trust-over-ip",
    "decentralized-identity",
    "ssi",
    "typescript",
    "webcrypto",
    "key-storage",
    "wallet",
    "passkey",
    "webauthn",
    "prf",
    "indexeddb",
    "browser",
    "vault"
  ],
  "homepage": "https://toip.tools/toolkit/web-vault/",
  "bugs": {
    "url": "https://github.com/yourbuddyconner/toip-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourbuddyconner/toip-tools.git",
    "directory": "packages/web-vault"
  },
  "license": "Apache-2.0",
  "author": "Conner Swann",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@toip-tools/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@toip-tools/trust-core": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fake-indexeddb": "6.2.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
