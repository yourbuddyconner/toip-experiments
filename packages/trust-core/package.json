{
  "name": "@toip-tools/trust-core",
  "version": "0.1.0",
  "description": "Trust over IP core for TypeScript: did:key identities, signed and encrypted Trust Tasks over TSP (the Trust Spanning Protocol), W3C verifiable credentials, status lists and local policy.",
  "keywords": [
    "toip",
    "trust-over-ip",
    "decentralized-identity",
    "ssi",
    "typescript",
    "trust-spanning-protocol",
    "did",
    "did-key",
    "verifiable-credentials",
    "w3c-vc",
    "data-integrity",
    "status-list",
    "encryption",
    "trust-tasks",
    "tsp",
    "opa"
  ],
  "homepage": "https://toip.tools/toolkit/trust-core/",
  "bugs": {
    "url": "https://github.com/yourbuddyconner/toip-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourbuddyconner/toip-tools.git",
    "directory": "packages/trust-core"
  },
  "license": "Apache-2.0",
  "author": "Conner Swann",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@toip-tools/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixtures": "opa build -t wasm -e fixture/decision -o tests/fixtures/bundle.tar.gz tests/fixtures/fixture.rego && tar -xzf tests/fixtures/bundle.tar.gz -C tests/fixtures /policy.wasm && rm tests/fixtures/bundle.tar.gz"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@open-policy-agent/opa-wasm": "1.10.0",
    "@openvtc/trust-tasks": "0.28.17",
    "@openvtc/trust-tasks-proof": "0.1.6",
    "@openvtc/trust-tasks-tsp": "0.1.2",
    "@openvtc/vti-tsp-js": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
