{
  "name": "@toip-tools/anon-membership",
  "version": "0.1.0",
  "description": "Prove group membership and attribute requirements without revealing which member you are.",
  "keywords": [
    "toip",
    "zero-knowledge",
    "zk",
    "noir",
    "ultrahonk",
    "membership",
    "nullifier",
    "privacy"
  ],
  "homepage": "https://toip.tools/toolkit/anon-membership/",
  "bugs": {
    "url": "https://github.com/yourbuddyconner/toip-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourbuddyconner/toip-tools.git",
    "directory": "packages/anon-membership"
  },
  "license": "Apache-2.0",
  "author": "Conner Swann",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@toip-tools/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "@toip-tools/source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "artifacts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:circuits": "tsx --conditions=@toip-tools/source scripts/build-circuits.ts",
    "vectors": "tsx --conditions=@toip-tools/source scripts/vectors.ts",
    "bench": "tsx --conditions=@toip-tools/source scripts/bench.ts"
  },
  "dependencies": {
    "@aztec/bb.js": "npm:@aztec-foundation/bb.js@6.0.0",
    "@noble/hashes": "2.4.0",
    "@noir-lang/noir_js": "1.0.0",
    "@toip-tools/trust-core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "playwright": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
