{
  "name": "toip-tools",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/trust-core",
    "packages/cose",
    "packages/web-vault",
    "packages/relay",
    "packages/mandates",
    "packages/anon-membership",
    "packages/eventlog",
    "packages/mesh-transport",
    "projects/shared-todo",
    "projects/settle",
    "projects/trail",
    "projects/agora",
    "projects/tipline",
    "projects/agents",
    "projects/mesh",
    "projects/capture"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "licenses": "node scripts/check-licenses.mjs",
    "dev": "node scripts/dev.mjs",
    "settle": "npm run app --workspace @toip-tools/settle",
    "trail": "npm run app --workspace @toip-tools/trail",
    "agora": "npm run app --workspace @toip-tools/agora",
    "tipline": "npm run app --workspace @toip-tools/tipline",
    "agents": "npm run app --workspace @toip-tools/agents",
    "mesh": "npm run app --workspace @toip-tools/mesh",
    "capture": "npm run app --workspace @toip-tools/capture"
