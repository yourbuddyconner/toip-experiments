{
  "name": "toip-tools",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/trust-core",
    "packages/cose",
    "packages/web-vault",
    "packages/relay",
    "packages/mandates",
    "packages/anon-membership",
    "packages/eventlog",
    "packages/mesh-transport",
    "projects/shared-todo",
    "projects/settle",
    "projects/trail",
    "projects/agora",
    "projects/tipline",
    "projects/agents",
    "projects/mesh",
    "projects/capture"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace packages",
    "licenses": "node scripts/check-licenses.mjs",
    "release:check": "npm run build && node scripts/release-check.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "release": "npm run build && changeset publish",
    "dev": "node scripts/dev.mjs",
    "settle": "npm run app --workspace @toip-tools/settle",
    "trail": "npm run app --workspace @toip-tools/trail",
    "agora": "npm run app --workspace @toip-tools/agora",
    "tipline": "npm run app --workspace @toip-tools/tipline",
    "agents": "npm run app --workspace @toip-tools/agents",
    "mesh": "npm run app --workspace @toip-tools/mesh",
    "capture": "npm run app --workspace @toip-tools/capture"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3"
  }
}
