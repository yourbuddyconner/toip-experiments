{
  "name": "@toip-tools/settle",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build:program": "cd program && mkdir -p target/deploy && cp keys/settle_escrow-keypair.json target/deploy/ && cargo build-sbf && cp target/deploy/settle_escrow.so dist/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "policies": "opa build -t wasm -e settle/attested_completion/decision -o policies/bundle.tar.gz policies/attested-completion.rego && tar -xzf policies/bundle.tar.gz -C policies /policy.wasm && rm policies/bundle.tar.gz",
    "demo": "tsx --conditions=@toip-tools/source src/demo.ts",
    "app": "tsx --conditions=@toip-tools/source src/platform/main.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "e2e": "tsx --conditions=@toip-tools/source web/e2e.ts",
    "deploy": "tsx --conditions=@toip-tools/source src/platform/deploy.ts",
    "test:cluster": "vitest run tests/cluster.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.6.0",
    "@toip-tools/trust-core": "0.1.0",
    "@toip-tools/web-vault": "0.1.0",
    "litesvm": "1.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@toip-tools/relay": "0.1.0",
    "playwright": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
