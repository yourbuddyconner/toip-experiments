{
  "name": "toip-tools-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The toip.tools developer site: a static build of plain TypeScript templates.",
  "scripts": {
    "build": "tsx build/build.ts",
    "dev": "tsx build/serve.ts --watch",
    "preview": "tsx build/serve.ts",
    "check": "node --import tsx --test build/highlight.test.ts build/sdk-api.test.ts && tsx build/check.ts",
    "typecheck": "tsc -p tsconfig.json",
    "quickstart": "tsx examples/quickstart/run-all.ts",
    "examples:record": "tsx build/record-examples.ts",
    "links": "tsx build/links.ts",
    "screenshots": "tsx build/screenshots.ts",
    "test:ui": "node --import tsx --test build/ui.test.ts",
    "licenses": "tsx build/licenses.ts"
  },
  "devDependencies": {
    "@fontsource-variable/recursive": "5.3.0",
    "@types/node": "26.6.6",
    "marked": "18.1.3",
    "playwright": "1.65.0",
    "shiki": "4.6.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
